{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$id": "http://example.com/example.json",
    "type": "object",
    "default": {},
    "title": "Root Schema",
    "required": [
        "skill_id",
        "skill_name"
    ],
    "properties": {
        "skill_id": {
            "type": "integer",
            "default": 0,
            "title": "The skill_id Schema",
            "examples": [
                3421
            ]
        },
        "skill_name": {
            "type": "string",
            "default": "",
            "title": "The skill_name Schema",
            "examples": [
                "RDBMS"
            ]
        }
    },
    "examples": [{
        "skill_id": 3421,
        "skill_name": "RDBMS"
    }]
}